POSTGRES_DB=enso
POSTGRES_USER=enso
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# Dev seulement (front Vite sur 5173 qui appelle l'API sur 8000). Avec Docker, Caddy sert
# front et API sur la même adresse : CORS n'intervient pas.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Docker : ports du site sur la machine, et adresse servie par Caddy
# (:80 en local en HTTP ; un nom de domaine sur VPS pour le HTTPS automatique).
HTTP_PORT=8080
HTTPS_PORT=8443
SITE_ADDRESS=:80

# ETL (docker compose run --rm etl) : date de téléchargement du fichier NOAA importé.
ETL_EXTRACTED_ON=2026-11-14
